# -------------------------------------------------------------
# Alumni Tracking System - Example Environment Configuration
# Copy this file to '.env' and customize values:
#   cp .example.env .env
# -------------------------------------------------------------

# Backend Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://alumni_user:alumni_pass@db:5432/alumni_db

# PostgreSQL Container Credentials
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=alumni_pass
POSTGRES_DB=alumni_db
POSTGRES_PORT=5433

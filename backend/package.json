{
  "name": "alumni-backend",
  "version": "1.0.0",
  "description": "Alumni Tracking System - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node src/db/initDb.js",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "node src/db/migrate.js --rollback",
    "db:seed": "node src/db/seed.js",
    "db:seed:clean": "node src/db/seed.js --clean",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js --clean"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  }
}

